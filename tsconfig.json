{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",  // Changed to ESNext for Vercel compatibility
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "outDir": "lib",
    "sourceMap": true,
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "API",
    "**/*.d.ts"  // Include .d.ts files
  ],
  "exclude": [
    "node_modules", 
    "**/*.spec.ts", 
    "**/*.test.ts",
    "**/__tests__/**/*" // Exclude any test directories
  ],
  "compileOnSave": true,
  "references": [{ "path": "./tsconfig.node.json" }]
}